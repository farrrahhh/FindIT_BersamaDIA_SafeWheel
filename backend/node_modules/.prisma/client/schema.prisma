generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model UserWheelchair {
  safewheel_id         String                  @id @db.VarChar(255)
  user_email           String?                 @unique(map: "user_email") @db.VarChar(255)
  user_password        String?                 @db.VarChar(255)
  user_name            String?                 @db.VarChar(255)
  sex                  Sex?
  dob                  DateTime?               @db.Date
  bloodtype            String?                 @db.VarChar(5)
  emergency_number     String?                 @db.VarChar(20)
  location_coordinates String?                 @db.VarChar(255)
  health_item          HealthItem[]
  alerts               UserAlertNotification[]
  guardians            UserGuardian[]

  @@map("user_wheelchair")
}

model UserGuardian {
  guardian_email    String          @id @db.VarChar(255)
  guardian_password String?         @db.VarChar(255)
  guardian_name     String?         @db.VarChar(255)
  safewheel_id      String?         @db.VarChar(255)
  user              UserWheelchair? @relation(fields: [safewheel_id], references: [safewheel_id], onDelete: NoAction, onUpdate: NoAction, map: "user_guardian_ibfk_1")

  @@index([safewheel_id], map: "safewheel_id")
  @@map("user_guardian")
}

model HealthItem {
  safewheel_id    String         @db.VarChar(255)
  user_timestamp  DateTime       @db.DateTime(0)
  oxylevel        Int?
  heartrate       Int?
  user_wheelchair UserWheelchair @relation(fields: [safewheel_id], references: [safewheel_id], onDelete: NoAction, onUpdate: NoAction, map: "health_item_ibfk_1")

  @@id([safewheel_id, user_timestamp])
  @@map("health_item")
}

model UserAlertNotification {
  safewheel_id    String         @db.VarChar(255)
  alert_timestamp DateTime       @db.DateTime(0)
  user            UserWheelchair @relation(fields: [safewheel_id], references: [safewheel_id], onDelete: NoAction, onUpdate: NoAction, map: "user_alert_notification_ibfk_1")

  @@id([safewheel_id, alert_timestamp])
  @@map("user_alert_notification")
}

enum Sex {
  male
  female
  other
}
