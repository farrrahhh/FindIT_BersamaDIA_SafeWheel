{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./app/*"]
    },
    "jsx": "react-native",
    "typeRoots": ["./node_modules/@types", "./app/types"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,  // Optional: useful if you import .ts/.tsx files directly
    "moduleResolution": "node16",          // Explicitly set to match Node resolution
    "module": "Node16",                    // Required when moduleResolution is set to Node16
    "types": ["expo"]
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "babel.config.js",
    "metro.config.js",
    "jest.config.js"
  ]
}